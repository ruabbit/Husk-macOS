+void SetJITHostHooks(const JITHostHooks& Hooks) {
+  auto& Table = GetJITMappingTable();
+  std::lock_guard<std::mutex> Lock(Table.Mutex);
+  if (HostHooksPublished.load(std::memory_order_relaxed)) {
+    LogMan::Msg::EFmt("FEX JIT host already installed; refusing replacement");
+    return;
+  }
+  const uintptr_t RXBase = Hooks.RWBase + static_cast<uintptr_t>(Hooks.Delta);
+  const bool Valid = Hooks.Alloc && Hooks.Free && Hooks.RWBase && RXBase && Hooks.Size &&
+                     Hooks.Size <= UINTPTR_MAX - Hooks.RWBase && Hooks.Size <= UINTPTR_MAX - RXBase &&
+                     Table.WriteToExec.empty();
+  // An invalid attempted host binding stays failed, never falls back to a
+  // private executable mapping beyond the host's memory limit.
+  HostHooks = Valid ? Hooks : JITHostHooks {};
+  HostHooksPublished.store(true, std::memory_order_release);
+  if (!Valid) LogMan::Msg::EFmt("invalid or late FEX JIT host binding");
+}
